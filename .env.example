# Keystatic GitHub app — needed only for editing content at /keystatic.
# The public site builds and deploys fine without these.
#
# To generate them, run the site locally and open the setup wizard:
#
#   pnpm dev
#   open http://localhost:3000/keystatic/setup
#
# Enter https://mattmattdesign.com as the Deployed App URL, leave the
# organization blank, and click "Create GitHub App". GitHub sends you back and
# Keystatic writes the three values into a local .env file (already gitignored).
# Copy them into Vercel → Settings → Environment Variables, then redeploy.
#
# To edit content locally without any of this:  KEYSTATIC_STORAGE=local pnpm dev

# All four go into Vercel — the app slug is easy to miss, and the login
# button cannot work without it.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Only if the domain ever changes.
# NEXT_PUBLIC_SITE_URL=https://mattmattdesign.com

# AI tab — all values stay on the server. The model IDs are checked against a
# two-item free-model allowlist; changing them to a paid model is rejected.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=z-ai/glm-5.2:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
AI_TURN_SECRET=

# Email handoff — verify the sender domain in Resend before production use.
RESEND_API_KEY=
AI_CONTACT_FROM=
AI_CONTACT_TO=

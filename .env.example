# Keystatic GitHub app — needed only for editing content at /keystatic.
# The public site builds and deploys fine without these.
#
# To generate them, run the site locally and open the setup wizard:
#
#   pnpm dev
#   open http://localhost:3000/keystatic/setup
#
# Enter https://mattmattdesign.com as the Deployed App URL, leave the
# organization blank, and click "Create GitHub App". GitHub sends you back and
# Keystatic writes the three values into a local .env file (already gitignored).
# Copy them into Vercel → Settings → Environment Variables, then redeploy.
#
# To edit content locally without any of this:  KEYSTATIC_STORAGE=local pnpm dev

# All four go into Vercel — the app slug is easy to miss, and the login
# button cannot work without it.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Only if the domain ever changes.
# NEXT_PUBLIC_SITE_URL=https://mattmattdesign.com

# AI tab — all values stay on the server, and all four belong in Vercel too.
#
# The model IDs are checked against a two-item free-model allowlist; anything
# else is ignored with a warning and falls back, so a paid model cannot enter
# the request path. They must match the allowlist exactly, `:free` suffix
# included, or the variable silently does nothing.
#
# AI_TURN_SECRET signs the cookie that ties a follow-up to its first question.
# Locally it falls back to a development value, so the AI answers on your own
# machine whether or not this is set — but in production it throws, and every
# request to /api/ai comes back 503. Generate one with:
#
#   openssl rand -base64 32
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=z-ai/glm-5.2
OPENROUTER_FALLBACK_MODEL=openrouter/free
AI_TURN_SECRET=

# Email handoff. AI_CONTACT_FROM must sit on a domain verified in Resend or the
# send is rejected; AI_CONTACT_TO is where the handoff lands.
RESEND_API_KEY=
AI_CONTACT_FROM=
AI_CONTACT_TO=

# Keystatic GitHub app — needed only for the live CMS at /keystatic.
# Local development uses the filesystem and needs none of these.
#
# Visit https://mattmattdesign.com/keystatic after the first deploy; Keystatic
# walks you through creating the GitHub app and prints these three values.
# Paste them into Vercel → Settings → Environment Variables (all environments),
# then redeploy.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Only if the domain ever changes.
# NEXT_PUBLIC_SITE_URL=https://mattmattdesign.com
